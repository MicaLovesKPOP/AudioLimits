<Page
    x:Class="AudioLimits.App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:AudioLimits.App.ViewModels">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="920"
                  HorizontalAlignment="Center"
                  Padding="32,26,32,36">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6"
                                Margin="0,0,0,4">
                        <TextBlock Text="Output devices"
                                   Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Set a maximum for each playback device. Windows volume still runs from 0–100%; at 100%, the device won't exceed the limit you set."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="780"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <InfoBar x:Name="StateInfoBar"
                             Margin="0,2,0,2"
                             IsOpen="False"
                             IsClosable="True" />

                    <StackPanel x:Name="LoadingPanel"
                                HorizontalAlignment="Center"
                                Margin="0,54,0,34"
                                Spacing="14">
                        <ProgressRing Width="32" Height="32" IsActive="True" />
                        <TextBlock Text="Checking the current audio state…"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="EmptyStatePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                Margin="0,54,0,34"
                                Spacing="8">
                        <FontIcon Glyph="&#xE767;"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No playback devices"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Connect or enable a Windows playback device, then reopen Audio Limits."
                                   MaxWidth="440"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ItemsRepeater x:Name="DeviceRepeater"
                                   Visibility="Collapsed"
                                   ItemsSource="{x:Bind Devices, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DeviceViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        AutomationProperties.Name="{x:Bind DisplayName}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Padding="20,18,20,16"
                                              ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="32"
                                                  Height="32"
                                                  VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE767;"
                                                          FontSize="26"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Grid>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind DeviceDescription}"
                                                           Visibility="{x:Bind HasDeviceDescription}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <ProgressRing Width="16"
                                                              Height="16"
                                                              IsActive="{x:Bind IsOperationInProgress, Mode=OneWay}"
                                                              Visibility="{x:Bind IsOperationInProgress, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="170" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                Margin="20,0,20,0" />

                                        <StackPanel Grid.Row="2">
                                            <InfoBar IsOpen="{x:Bind IsLimitInactive}"
                                                     IsClosable="False"
                                                     Severity="Warning"
                                                     Margin="20,14,20,0"
                                                     Title="{x:Bind InactiveLimitTitle}"
                                                     Message="{x:Bind InactiveLimitMessage}" />

                                            <Grid Padding="20,15,20,10"
                                                  ColumnSpacing="24"
                                                  RowSpacing="11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="72" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Windows volume"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind WindowsVolumeText, Mode=OneWay}"
                                                           HorizontalAlignment="Right" />

                                                <TextBlock Grid.Row="1"
                                                           Text="Same output without limit"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind SameOutputWithoutLimitText, Mode=OneWay}"
                                                           HorizontalAlignment="Right"
                                                           ToolTipService.ToolTip="{x:Bind SameOutputHelpText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid Visibility="{x:Bind HasHardwareVolume}"
                                                  Padding="20,1,20,8"
                                                  ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE946;"
                                                          FontSize="14"
                                                          Margin="0,2,0,0"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind HardwareVolumeNotice}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Padding="20,4,20,18">
                                                <Button Content="{x:Bind SetLimitButtonText}"
                                                        Tag="{x:Bind Device.Id}"
                                                        IsEnabled="{x:Bind CanSetLimit, Mode=OneWay}"
                                                        Click="SetLimitButton_Click"
                                                        AutomationProperties.Name="{x:Bind SetLimitAutomationName}" />
                                                <Grid Background="Transparent"
                                                      ToolTipService.ToolTip="{x:Bind SetCurrentHelpText, Mode=OneWay}">
                                                    <Button Content="Set current output as limit"
                                                            Tag="{x:Bind Device.Id}"
                                                            IsEnabled="{x:Bind CanSetCurrent, Mode=OneWay}"
                                                            Click="SetCurrentButton_Click"
                                                            AutomationProperties.Name="{x:Bind SetCurrentAutomationName}" />
                                                </Grid>
                                                <Button Content="Remove limit"
                                                        Tag="{x:Bind Device.Id}"
                                                        Visibility="{x:Bind HasLimit}"
                                                        IsEnabled="{x:Bind CanRemoveLimit, Mode=OneWay}"
                                                        Click="RemoveLimitButton_Click"
                                                        AutomationProperties.Name="{x:Bind RemoveLimitAutomationName}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
