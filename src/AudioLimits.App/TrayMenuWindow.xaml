<Window
    x:Class="AudioLimits.App.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid TabFocusNavigation="Cycle"
          KeyDown="MenuRoot_KeyDown">
        <!-- A real focus target is required to clear retained command focus between
             invocations. It sits outside MenuRoot's command-only Tab cycle, remains
             invisible, and is reached only by our programmatic pointer-open reset. -->
        <Button x:Name="FocusSink"
                Width="1"
                Height="1"
                Opacity="0"
                Padding="0"
                Margin="0"
                IsTabStop="True"
                IsHitTestVisible="False"
                UseSystemFocusVisuals="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw" />

        <Border x:Name="MenuRoot"
                MinWidth="220"
                MaxWidth="360"
                Padding="4"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                TabFocusNavigation="Cycle">
            <StackPanel Spacing="0">
                <Button x:Name="OpenButton"
                        Content="Open Audio Limits"
                        MinHeight="36"
                        Padding="12,7"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OpenButton_Click"
                        AutomationProperties.Name="Open Audio Limits" />

                <Button x:Name="SettingsButton"
                        Content="Settings"
                        MinHeight="36"
                        Padding="12,7"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="SettingsButton_Click"
                        AutomationProperties.Name="Settings" />

                <Border Height="1"
                        Margin="8,4"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        IsHitTestVisible="False" />

                <Button x:Name="ExitButton"
                        Content="Exit"
                        MinHeight="36"
                        Padding="12,7"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="ExitButton_Click"
                        AutomationProperties.Name="Exit Audio Limits" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
